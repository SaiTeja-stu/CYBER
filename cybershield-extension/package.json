{
  "name": "cybershield-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "test": "esbuild test/domain_and_verdict.test.mjs --bundle --platform=node --format=esm --outfile=test/bundle.test.mjs && node --test test/bundle.test.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
