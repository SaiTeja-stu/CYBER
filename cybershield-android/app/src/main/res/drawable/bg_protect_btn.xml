<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/protect_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/protect_start"
                android:endColor="@color/protect_end" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/protect_stroke" />
        </shape>
    </item>
</ripple>
