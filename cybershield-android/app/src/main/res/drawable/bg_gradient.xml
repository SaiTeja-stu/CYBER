<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="120"
                android:startColor="@color/bg_a"
                android:centerColor="@color/bg_b"
                android:endColor="@color/bg_c" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="0.12" android:centerY="0.02"
                android:startColor="@color/bg_glow"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
