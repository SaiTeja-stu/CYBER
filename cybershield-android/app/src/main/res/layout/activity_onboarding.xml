<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Protect my whole phone"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Everything is checked on your phone. Nothing leaves it."
            android:textColor="@color/muted"
            android:textSize="13.5sp" />

        <!-- Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 of 4 turned on"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Takes about a minute"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="4"
                app:indicatorColor="@color/cyber_emerald"
                app:trackColor="@color/nav_neon_soft"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />
        </LinearLayout>

        <!-- Permissions -->
        <TextView
            style="@style/DashHeading"
            android:text="Turn these on" />

        <include android:id="@+id/rowSms" layout="@layout/item_permission_row" />
        <include android:id="@+id/rowOverlay" layout="@layout/item_permission_row" />
        <include android:id="@+id/rowAccessibility" layout="@layout/item_permission_row" />
        <include android:id="@+id/rowNotif" layout="@layout/item_permission_row" />

        <TextView
            android:id="@+id/tvRestricted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Setting greyed out? Open App info → ⋮ → Allow restricted settings."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Preferences -->
        <TextView
            style="@style/DashHeading"
            android:text="How it protects you" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical">

            <include android:id="@+id/setBrowser" layout="@layout/item_setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="16dp" android:background="@color/cyber_card_stroke" />
            <include android:id="@+id/setStrict" layout="@layout/item_setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="16dp" android:background="@color/cyber_card_stroke" />
            <include android:id="@+id/setLock" layout="@layout/item_setting_row" />
        </LinearLayout>

        <!-- SMS checks -->
        <TextView
            style="@style/DashHeading"
            android:text="Text messages" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_stat_card"
            android:orientation="vertical">

            <include android:id="@+id/setDlt" layout="@layout/item_setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="16dp" android:background="@color/cyber_card_stroke" />
            <include android:id="@+id/setQuietBank" layout="@layout/item_setting_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="16dp" android:background="@color/cyber_card_stroke" />
            <include android:id="@+id/setPromo" layout="@layout/item_setting_row" />
        </LinearLayout>

        <!-- Try it -->
        <TextView
            style="@style/DashHeading"
            android:text="Try it out" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="See how SecureMe reacts. These are samples, nothing is sent."
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/btnTestLegitSms"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real bank alert"
                app:chipIcon="@drawable/ic_sms"
                app:chipIconTint="@color/cyber_emerald" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnTestSms"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fake bank SMS"
                app:chipIcon="@drawable/ic_warning"
                app:chipIconTint="@color/cyber_crimson" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnTestEmail"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phishing email"
                app:chipIcon="@drawable/ic_mail"
                app:chipIconTint="@color/cyber_crimson" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</ScrollView>
