<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn to spot scams"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:text="Six short lessons, about a minute each. Tap one to start, or listen along." />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/langGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.chip.Chip android:id="@+id/langEn" style="@style/Widget.Material3.Chip.Filter" android:text="English" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.chip.Chip android:id="@+id/langTe" style="@style/Widget.Material3.Chip.Filter" android:text="తెలుగు" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <com.google.android.material.chip.Chip android:id="@+id/langHi" style="@style/Widget.Material3.Chip.Filter" android:text="हिन्दी" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/muted"
        android:text="Loading…" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp" />
</LinearLayout>
