<resources>
    <!-- Android 12+ always shows a system splash; make it a blank white frame (no icon) so it
         hands off invisibly to SplashActivity's animated loading screen. -->
    <style name="Theme.SecureMe.Splash" parent="Theme.CyberShield">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
