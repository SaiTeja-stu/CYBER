<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CyberShield" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sky</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@color/bg_b</item>
        <item name="android:navigationBarColor">@color/bg_c</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:windowAnimationStyle">@style/SecureMeWindowAnim</item>
    </style>

    <!-- Launch: plain white window so the animated loading screen is the only one the user sees.
         Android 12+ splash attributes are in values-v31/themes.xml. -->
    <style name="Theme.SecureMe.Splash" parent="Theme.CyberShield">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Sign in / Auth screen: no action bar before sign-in -->
    <style name="Theme.SecureMe.Auth" parent="Theme.CyberShield">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/bg_a</item>
        <item name="android:navigationBarColor">@color/bg_c</item>
    </style>

    <style name="Theme.CyberShield.Transparent" parent="Theme.CyberShield">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- screen-to-screen transitions: soft fade + short rise, like the reference design -->
    <style name="SecureMeWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <style name="OnbStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OnbBtn" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="AuthField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="boxBackgroundColor">@color/glass_dim</item>
        <item name="boxStrokeColor">@color/glass_edge</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- frosted-glass stat / content card -->
    <style name="DashCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="cardBackgroundColor">@color/glass</item>
        <item name="strokeColor">@color/glass_edge</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- full-width frosted card -->
    <style name="GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/glass</item>
        <item name="strokeColor">@color/glass_edge</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="DashHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
